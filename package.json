{
  "name": "lifeguard-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:mcp": "npm run dev --workspace=packages/mcp-server",
    "dev:backend": "npm run dev --workspace=packages/backend",
    "dev:frontend": "npm run dev --workspace=packages/frontend",
    "dev:desktop": "npm run dev --workspace=packages/desktop",
    "dev": "concurrently \"npm run dev:mcp\" \"npm run dev:backend\" \"npm run dev:frontend\" \"npm run dev:desktop\"",
    "build": "npm run build --workspaces",
    "test": "npm run build",
    "install-all": "npm install"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
